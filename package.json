{
  "name": "rsi-plus",
  "description": "RSI site + Spectrum, better: hangar/buyback explorer, CCU planner, wishlist alerts, Spectrum read tracking, mutes, watches, friends manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "@wxt-dev/module-svelte": "^2.0.5",
    "happy-dom": "^20.14.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
