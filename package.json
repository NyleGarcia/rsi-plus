{
  "name": "rsi-plus",
  "description": "RSI site + Spectrum, better: hangar/buyback explorer, CCU planner, wishlist alerts, Spectrum read tracking, mutes, watches, friends manager",
  "private": true,
  "license": "MIT",
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:brave": "wxt zip -b brave",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b edge && wxt zip -b brave && wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "perf": "node scripts/perf-audit.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "@wxt-dev/module-svelte": "^2.0.5",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.50.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.56.0",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "layerchart": "^2.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  }
}
